# Mnemo configuration. Copy to .env and fill in; every setting is in the
# README's configuration reference. This file holds no real values.

# --- Mnema Talk ------------------------------------------------------------
# Your server's address, and the bot token shown once when you added Mnemo
# (Admin area > Bots). Use MNEMA_TOKEN_FILE=/run/secrets/... instead to keep
# the token out of the environment.
MNEMA_URL=https://talk.example.org
MNEMA_TOKEN=

# --- AI provider -----------------------------------------------------------
# anthropic (default), openai, openai-compatible (Ollama, OpenRouter,
# LM Studio, vLLM, ...), or fake (no AI: echoes the question, for a dry run).
MNEMO_PROVIDER=anthropic
# Your key from the provider's console. Not needed for a local server.
MNEMO_API_KEY=
# Default for anthropic: claude-haiku-5-5. Required for the other providers.
# MNEMO_MODEL=
# Required for openai-compatible, for example http://localhost:11434/v1
# MNEMO_BASE_URL=

# --- Optional web search (off without a key) -------------------------------
# MNEMO_SEARCH_PROVIDER=brave
# MNEMO_SEARCH_API_KEY=

# --- Privacy and limits ----------------------------------------------------
# Send the asker's display name to the provider (default false).
# MNEMO_SEND_DISPLAY_NAME=false
# Only answer in these channels (comma-separated IDs); empty means every
# channel Mnemo can see.
# MNEMO_ALLOWED_CHANNELS=
# MNEMO_MEMBER_LIMIT_PER_MINUTE=5
# MNEMO_CHANNEL_LIMIT_PER_MINUTE=20
# MNEMO_DAILY_TOKEN_BUDGET=1000000
# MNEMO_DAILY_COST_BUDGET_USD=0
