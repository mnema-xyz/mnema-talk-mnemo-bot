{
  "manifest_version": 1,
  "name": "Mnemo",
  "description": "A self-hosted AI helper: answers questions with live weather, a calculator, time zones, unit conversion and Wikipedia. You run it with your own AI provider and key.",
  "homepage": "https://github.com/msch128/mnema-talk-mnemo-bot",
  "avatar": "data:image/png;base64,",
  "intents": [
    "GUILD_MESSAGES"
  ],
  "permissions": [
    "view_channel",
    "send_messages",
    "add_reactions"
  ],
  "commands": [
    {
      "name": "ask",
      "description": "Ask Mnemo a question",
      "options": [
        {
          "name": "question",
          "description": "What do you want to know?",
          "type": 3,
          "required": true
        },
        {
          "name": "private",
          "description": "Only you see the answer",
          "type": 5,
          "required": false
        }
      ]
    }
  ]
}
