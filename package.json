{
  "name": "mnemo",
  "version": "0.1.0",
  "description": "Mnemo, a self-hosted AI helper bot for Mnema Talk: bring your own AI provider and key.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/msch128/mnema-talk-mnemo-bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msch128/mnema-talk-mnemo-bot.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "test:integration": "node --test 'test/integration/*.itest.ts'",
    "typecheck": "tsc",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "config-schema": "node scripts/config-schema.ts",
    "manifest": "node scripts/manifest.ts",
    "add-link": "node scripts/add-link.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "mnema-talk-sdk": "file:vendor/mnema-talk-sdk-3.0.11.tgz",
    "openai": "7.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
